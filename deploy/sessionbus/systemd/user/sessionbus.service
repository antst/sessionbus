[Unit]
Description=Sessionbus host daemon
Documentation=https://github.com/antst/sessionbus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/sessionbus/service.env
RuntimeDirectory=sessionbus
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=@PREFIX@/libexec/sessionbus/host/current/bin/sessionbus
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
