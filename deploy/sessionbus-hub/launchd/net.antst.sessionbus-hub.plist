<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.antst.sessionbus-hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PREFIX@/libexec/sessionbus/hub/current/bin/sessionbus-hub</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@HOME@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>PATH</key>
    <string>@SERVICE_PATH@</string>
    <key>SESSIONBUS_HUB_LISTEN</key>
    <string>:7419</string>
    <key>SESSIONBUS_HUB_CONFIG</key>
    <string>@HOME@/.config/sessionbus/hub.json</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
