#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Check the shared stable release version before any publication."""
import json
import pathlib
import re
import sys

tag = sys.argv[1] if len(sys.argv) == 2 else ""
if not re.fullmatch(r"v(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)", tag):
    sys.exit("expected a stable release tag vMAJOR.MINOR.PATCH")
root = pathlib.Path(__file__).resolve().parent.parent
package = json.loads((root / "bus/package.json").read_text())
if tag != "v" + package["version"]:
    sys.exit(f"tag {tag} does not match bus/package.json version {package['version']}")
print(f"Release version verified: {tag}")
